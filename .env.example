# MailMind Environment Variables Configuration

# Server
PORT=8000
ENVIRONMENT=development
SECRET_KEY=generate_a_random_jwt_secret_key_here
TOKEN_ENCRYPTION_KEY=generate_32_byte_base64_encryption_key_here

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://mailmind:mailmind_secret_password@localhost:5432/mailmind_db
POSTGRES_USER=mailmind
POSTGRES_PASSWORD=mailmind_secret_password
POSTGRES_DB=mailmind_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Pick your primary provider)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIzaSy...

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# LangSmith Observability & Evaluation
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=mailmind-assistant

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
