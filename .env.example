# The local demo does not currently load this file automatically.
PORT=8000
ENVIRONMENT=development
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Optional local infrastructure
DATABASE_URL=postgresql+asyncpg://mailmind:change-me@localhost:5432/mailmind_db
POSTGRES_USER=mailmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mailmind_db
REDIS_URL=redis://localhost:6379/0

# LLM providers (not required by the local demo)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google OAuth (not implemented)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Optional LangSmith tracing (not enabled by the local demo)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mailmind-assistant

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
